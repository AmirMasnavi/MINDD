        "user_active_sessions_at_start"
      ]
    },
    "categorical": [
      "post_id",
      "location",
      "district",
      "tariff_period"
    ]
  },
  "excluded": [
    {
      "column": "UserID",
      "category": "4 excluded for another reason",
      "reason": "Key field: 56,115 different accounts, most with one or two sessions, and a large share of the validation sessions comes from accounts not seen in training. A model would memorise accounts, and it would identify people. The user's *history* is the legitimate substitute."
    },
    {
      "column": "Order creation time",
      "category": "4 excluded for another reason",
      "reason": "Its availability at the prediction moment is not guaranteed: the order is stamped after the start in 57.2% of the training sessions, by up to hours. Its lag to the start also reflects how the start went."
    },
    {
      "column": "Transaction power/kwh",
      "category": "3 generated during/after the session",
      "reason": "Energy delivered during the session."
    },
    {
      "column": "Electricity cost/Yuan",
      "category": "3 generated during/after the session",
      "reason": "Cost of the energy delivered during the session."
    },
    {
      "column": "Service charge/Yuan",
      "category": "3 generated during/after the session",
      "reason": "Fee computed on the finished transaction."
    },
    {
      "column": "Transaction Amount/Yuan",
      "category": "3 generated during/after the session",
      "reason": "Sum of electricity cost and service charge, known only at the end."
    },
    {
      "column": "Actual Payment/Yuan",
      "category": "3 generated during/after the session",
      "reason": "Amount paid after the session."
    },
    {
      "column": "End Time",
      "category": "3 generated during/after the session",
      "reason": "Moment the session ended. It is only used to know *when a label becomes available* (the purge in Section 7), never as a predictor."
    },
    {
      "column": "Payment time",
      "category": "3 generated during/after the session",
      "reason": "Recorded after the session (before the end in 20% of the rows, so it is not even a clean timestamp)."
    },
    {
      "column": "end_cause",
      "category": "2 target construction only",
      "reason": "Reason why the session ended. It *is* the outcome, so it can only define the label."
    },
    {
      "column": "electricity_price",
      "category": "4 excluded for another reason",
      "reason": "Deterministic function of `tariff_period` (3 price levels for 7 periods), so it adds nothing."
    },
    {
      "column": "post_previous_abnormal_1D",
      "category": "4 excluded for another reason",
      "reason": "Exact function of the session count and the smoothed rate: abnormal = rate × (sessions + 5) − 1."
    },
    {
      "column": "post_previous_abnormal_7D",
      "category": "4 excluded for another reason",
      "reason": "Exact function of the session count and the smoothed rate."
    },
    {
      "column": "post_previous_abnormal_30D",
      "category": "4 excluded for another reason",
      "reason": "Exact function of the session count and the smoothed rate."
    },
    {
      "column": "post_no_previous_completed_session",
      "category": "4 excluded for another reason",
      "reason": "Constant after the burn-in: it is 1 only for the first session of each post, in January 2020."
    },
    {
      "column": "post_no_previous_completed_abnormal",
      "category": "4 excluded for another reason",
      "reason": "Constant after the burn-in (same reason)."
    },
    {
      "column": "user_previous_abnormal_30D",
      "category": "4 excluded for another reason",
      "reason": "Exact function of the session count and the smoothed rate."
    },
    {
      "column": "user_previous_abnormal_180D",
      "category": "4 excluded for another reason",
      "reason": "Exact function of the session count and the smoothed rate."
    },
    {
      "column": "user_previous_abnormal_730D",
      "category": "4 excluded for another reason",
      "reason": "Exact function of the session count and the smoothed rate."
    },
    {
      "column": "user_no_previous_completed_session",
      "category": "4 excluded for another reason",
      "reason": "Almost the same indicator as `is_new_user` (φ = 0.995, 0.1% of the rows differ)."
    }
  ],
